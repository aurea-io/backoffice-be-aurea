# Database (MongoDB connection string)
DATABASE_URL="mongodb://localhost:27017/aurea?authSource=admin"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# JWT Security
JWT_ACCESS_SECRET="aurea_dev_super_secret_jwt_key_change_in_production_123456789"
JWT_ACCESS_EXPIRES_IN="15m"
