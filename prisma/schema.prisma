generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  OWNER
  MANAGER
  STAFF
  CASHIER
}

enum CapabilityEffect {
  allow
  deny
}

enum EntitlementSource {
  plan
  tenant_setting
  owner_override
  migration
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

enum BillingInterval {
  month
  year
  one_time
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  TenantUser[]
  authTokens   AuthToken[] @relation("UserAuthTokens")
  platformMemberships PlatformMembership[]
}

model Tenant {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  name         String
  vertical     String   // e.g. "gastronomy", "beauty", "health", "realestate"
  isActive     Boolean  @default(true)
  maintenanceMode Boolean @default(false)
  maintenanceMessage String?
  deprecatedAt DateTime?
  publicAccessUntil DateTime?
  settings     Json?    // Branding, colors, logo, schedule, contact, social links
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  TenantUser[]
  features     TenantFeature[]
  entitlements TenantEntitlement[]
  subscriptions Subscription[]
  creditLedger CreditLedger[]
  catalogItems CatalogItem[]
  brandingVersions TenantBrandingVersion[]
}



// Versioned, validated tenant branding configuration.
// Values are tokens, never arbitrary CSS.
model TenantBrandingVersion {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  version      Int
  primaryColor String   @default("#7c3aed")
  accentColor  String   @default("#a78bfa")
  textColor    String   @default("#18181b")
  fontFamily   String   @default("sans")
  logoUrl      String?
  coverUrl     String?
  layoutTokens Json?
  overrides    Json?
  isPreview    Boolean  @default(false)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, version])
  @@index([tenantId, isPublished])
  @@index([tenantId, isPreview])
}

// Persisted, extensible RBAC matrix for platform and tenant scopes.
model RoleDefinition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  scope       String   // platform | tenant
  permissions String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, isActive])
}

model PlatformMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  roleKey   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleKey])
  @@index([userId, isActive])
}

// User-Tenant Relationship (M:N Membership)
model TenantUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  userId       String   @db.ObjectId
  role         Role     @default(STAFF)
  permissions  String[] // Granular permissions (custom RBAC)
  roleKey      String?  // Extensible role definition key; role remains for compatibility
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId]) // A user cannot have multiple base roles in the same tenant
  @@index([tenantId, isActive])
  @@index([userId, isActive])
}

model Plan {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  key         String       @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  prices      PlanPrice[]
  planAddons  PlanAddon[]
  subscriptions Subscription[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
}

model PlanPrice {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  planId        String          @db.ObjectId
  currency      String
  amountCents   Int
  interval      BillingInterval
  limits        Json?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  plan          Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency, interval])
  @@index([planId, isActive])
}

model Addon {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  key            String          @unique
  name           String
  description    String?
  priceCents     Int
  currency       String
  creditAmount   Int             @default(0)
  isActive       Boolean         @default(true)
  planAddons     PlanAddon[]
  subscriptions  SubscriptionAddon[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isActive])
}

model PlanAddon {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  planId    String   @db.ObjectId
  addonId   String   @db.ObjectId
  createdAt DateTime @default(now())

  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  addon     Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([planId, addonId])
  @@index([addonId])
}

model Subscription {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String             @db.ObjectId
  planId              String             @db.ObjectId
  status              SubscriptionStatus
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  gracePeriodEndsAt   DateTime?
  canceledAt          DateTime?
  limits              Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  addons              SubscriptionAddon[]
  creditLedger        CreditLedger[]

  @@index([tenantId, status])
  @@index([tenantId, currentPeriodEnd])
  @@index([planId, status])
}

model SubscriptionAddon {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String          @db.ObjectId
  addonId        String          @db.ObjectId
  quantity       Int              @default(1)
  status         SubscriptionStatus
  startsAt       DateTime         @default(now())
  endsAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon          Addon             @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, addonId])
  @@index([addonId, status])
}

model CreditLedger {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String        @db.ObjectId
  subscriptionId String?       @db.ObjectId
  amount         Int
  balanceAfter   Int
  kind           String
  reason         String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, kind, createdAt])
}

// Effective capability configuration selected for one tenant.
model TenantEntitlement {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String             @db.ObjectId
  capabilityKey String
  effect        CapabilityEffect
  source        EntitlementSource
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityKey, source])
  @@index([tenantId, capabilityKey, isActive])
}

// Active Modules / Features per Tenant (FBAC)
model TenantFeature {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  featureKey   String   // e.g. "bookings", "catalog", "delivery", "tables", "reviews"
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey]) // Unique feature per tenant
  @@index([tenantId, isEnabled])
}

model AuthToken {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  tokenHash    String   @unique
  type         String   // "MAGIC_LINK", "REFRESH_TOKEN", "PASSWORD_RESET"
  used         Boolean  @default(false)
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation("UserAuthTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Dynamic Business Catalog (Agnostic to industry: physical products or services)
model CatalogItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  title       String
  description String?
  priceCents  Int
  category    String?
  isService   Boolean  @default(false) // true: appointments/services, false: physical product/menu
  durationMin Int?     // Duration in minutes if service
  imageUrl    String?
  isActive    Boolean  @default(true)
  metadata    Json?    // Options, variants, tags
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// Global, platform-scoped definition of modules and functions.
// Tenant activation is intentionally stored separately in TenantFeature.
model ModuleCatalogEntry {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  key                 String   @unique
  kind                String   // module | function
  moduleKey           String
  sectionKey          String
  pageKey             String
  scope               String
  label               String
  status              String
  isArchived          Boolean  @default(false)
  requiredRole        String?
  permissions         String[]
  dependencies        String[]
  compatibility      Json
  availability       Json?
  metadata            Json?
  catalogVersion      String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([moduleKey])
  @@index([sectionKey, pageKey])
  @@index([status])
  @@index([isArchived])
}

// Invitation & Exclusive Registration Codes
model Invitation {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String    @unique
  email       String
  role        Role      @default(STAFF)
  tenantId    String?   @db.ObjectId
  expiresAt   DateTime
  used        Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([tenantId, used])
}
